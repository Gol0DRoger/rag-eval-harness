# Copy this file to ".env" and fill in your own values.

# Required: free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# --- Everything below is optional (remove the leading # to use it) ---

# LLM used for answers (Groq retires models over time; change it here if you get a 404)
# GROQ_MODEL=openai/gpt-oss-120b

# Logfire write token for traces (or run `logfire auth` instead).
# Without either one, the app still works and prints traces in the terminal.
# LOGFIRE_TOKEN=your_logfire_write_token

# Where the Streamlit UI and eval.py find the backend
# BACKEND_URL=http://127.0.0.1:8000
